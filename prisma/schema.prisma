generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  login        String    @unique
  passwordHash String
  role         String    @default("OWNER")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([expiresAt])
}

model Category {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String    @default("")
  image          String    @default("")
  position       Int       @default(0)
  published      Boolean   @default(false)
  seoTitle       String    @default("")
  seoDescription String    @default("")
  products       Product[]
}

model Producer {
  id          String    @id @default(cuid())
  name        String
  region      String    @default("")
  description String    @default("")
  products    Product[]
}

model Product {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  description     String         @default("")
  composition     String         @default("")
  region          String         @default("")
  weight          String         @default("")
  nutrition       String         @default("")
  storage         String         @default("")
  shelfLife       String         @default("")
  characteristics String         @default("")
  price           Int?
  showPrice       Boolean        @default(false)
  featured        Boolean        @default(false)
  published       Boolean        @default(false)
  position        Int            @default(0)
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  producerId      String?
  producer        Producer?      @relation(fields: [producerId], references: [id], onDelete: SetNull)
  images          ProductImage[]
  seoTitle        String         @default("")
  seoDescription  String         @default("")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([published, categoryId, position])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  position  Int     @default(0)

  @@index([productId, position])
}

model Store {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  description    String       @default("")
  address        String
  hours          String       @default("")
  phone          String       @default("")
  latitude       Float?
  longitude      Float?
  mapUrl         String       @default("")
  extra          String       @default("")
  published      Boolean      @default(false)
  position       Int          @default(0)
  seoTitle       String       @default("")
  seoDescription String       @default("")
  images         StoreImage[]
}

model StoreImage {
  id       String @id @default(cuid())
  storeId  String
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  url      String
  alt      String @default("")
  position Int    @default(0)

  @@index([storeId, position])
}

model Promotion {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  image       String    @default("")
  startsAt    DateTime?
  endsAt      DateTime?
  link        String    @default("")
  published   Boolean   @default(false)
  position    Int       @default(0)

  @@index([published, position])
}

model PartnershipRequest {
  id             String   @id @default(cuid())
  organization   String
  contact        String
  phone          String
  email          String   @default("")
  direction      String   @default("")
  comment        String   @default("")
  consentAt      DateTime
  consentVersion String   @default("2026-11-16")
  status         String   @default("NEW")
  note           String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
}

model SiteContent {
  id             String @id
  title          String
  subtitle       String @default("")
  body           String @default("")
  image          String @default("")
  seoTitle       String @default("")
  seoDescription String @default("")
}

model SiteSettings {
  id            Int    @id @default(1)
  name          String @default("Бурёнка от SOLOMONA")
  phone         String @default("")
  email         String @default("")
  address       String @default("")
  telegram      String @default("")
  vk            String @default("")
  requisites    String @default("")
  description   String @default("Дистрибьютор фермерской молочной продукции. Каталог и сотрудничество.")
  seoTitle      String @default("Бурёнка от SOLOMONA — фермерская молочная продукция")
  legalOperator String @default("")
  privacyText   String @default("")
  consentText   String @default("")
}

model Media {
  id        String   @id @default(cuid())
  url       String   @unique
  size      Int
  width     Int
  height    Int
  createdAt DateTime @default(now())
}
